---
import { siteConfig, getWhatsAppLink } from '../data/site.config';

const navLinks = [
  { name: 'Categorías', href: '#categorias' },
  { name: 'Catálogo', href: '#productos' },
  { name: 'Simulador Margen', href: '#simulador' },
  { name: 'Cómo Comprar', href: '#como-comprar' },
  { name: 'Local Once', href: '#ubicacion' },
];

const whatsAppUrl = getWhatsAppLink('¡Hola! Quiero solicitar la lista de precios mayoristas completa en PDF/Excel.');
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-[box-shadow,border-color] duration-150 ease-out bg-white/95 backdrop-blur-md border-b border-stone-200/80 shadow-soft-sm"
>
  <!-- Barra superior de aviso mayorista estilo Roma Store (Pastel Amarillo Manteca) -->
  <div class="bg-pastel-amarillo text-brand-dark py-1.5 px-4 text-center text-xs font-bold tracking-wide border-b border-stone-200/60">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 sm:gap-3">
      <span class="inline-flex items-center gap-1.5 font-extrabold uppercase text-[10px] sm:text-[11px] bg-brand-dark text-white px-2.5 py-0.5 rounded-full">
        MAYORISTA ONCE
      </span>
      <span class="hidden sm:inline">Pasteur 367, Once · Mínimo 1 bulto cerrado · Despacho a expresos en 24 hs · Factura A y B</span>
      <span class="sm:hidden truncate">Pasteur 367 · Mínimo 1 bulto · Envíos a todo el país</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Logo y Nombre de Marca -->
      <a
        href="#"
        class="flex items-center gap-3 shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-pastel-turquesa rounded-xl p-1"
        aria-label="Importadora Haote - Inicio"
      >
        <img
          src="/images/brand/logo.svg"
          alt="Importadora Haote"
          class="h-11 sm:h-12 w-auto object-contain transition-transform duration-150 hover:scale-[1.02]"
        />
      </a>

      <!-- Buscador rápido simulado (Inspirado en Roma Store) -->
      <div class="hidden lg:flex flex-1 max-w-md mx-4">
        <a
          href="#productos"
          class="w-full flex items-center gap-2.5 px-4 py-2 rounded-full bg-pastel-bg border border-stone-200 text-stone-400 text-xs sm:text-sm hover:border-pastel-turquesa transition-colors"
        >
          <svg class="w-4 h-4 text-stone-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="truncate">¿Qué juguetes buscás? Ej: Stitch, Lego, Spiderman...</span>
        </a>
      </div>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-brand-text hover:text-brand-dark px-3 py-2 text-sm font-semibold rounded-lg transition-colors hover:bg-pastel-bg focus-visible:ring-2 focus-visible:ring-pastel-turquesa"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Botón CTA WhatsApp Desktop con pastel Turquesa suave -->
      <div class="hidden sm:flex items-center gap-3 shrink-0">
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-tactile inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-sm lg:text-base border border-teal-300 shadow-soft-sm hover:bg-[#38C6D8] focus-visible:ring-2 focus-visible:ring-pastel-turquesa"
        >
          <!-- WhatsApp Icon -->
          <svg class="w-4 h-4 text-brand-dark fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.862 2.802.862l.006-.001c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.78-5.768zm3.364 8.169c-.14.394-.805.748-1.127.794-.322.046-.737.065-1.18-.08-.442-.144-1.014-.338-1.758-1.077-.927-.923-1.536-2.072-1.745-2.423-.209-.352-.022-.542.155-.717.158-.157.352-.404.528-.606.176-.202.234-.344.351-.572.117-.229.059-.429-.029-.606-.088-.176-.791-1.907-1.085-2.613-.286-.689-.577-.596-.791-.607-.205-.01-.44-.012-.674-.012-.235 0-.616.088-.939.44-.322.352-1.231 1.203-1.231 2.934 0 1.732 1.26 3.407 1.436 3.642.176.235 2.479 3.786 6.006 5.308.839.362 1.494.578 2.004.74.843.268 1.61.23 2.216.14.675-.101 2.08-.85 2.373-1.67.293-.82.293-1.523.205-1.67-.088-.147-.322-.235-.674-.411z"/>
          </svg>
          <span>Pedir Lista Mayorista</span>
        </a>
      </div>

      <!-- Botón Menú Mobile (Hamburguesa) -->
      <div class="flex sm:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-brand-dark bg-stone-100 hover:bg-stone-200 focus-visible:ring-2 focus-visible:ring-pastel-turquesa"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú Desplegable Mobile -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden fixed inset-0 top-[115px] bg-white/98 backdrop-blur-xl border-t border-stone-200 z-40 p-6 flex flex-col justify-between"
  >
    <div class="space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link block px-4 py-3 text-lg font-heading font-semibold text-brand-dark hover:text-teal-700 hover:bg-pastel-bg rounded-xl transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="pt-6 border-t border-stone-200">
      <a
        href={whatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-base shadow-sm"
      >
        <span>Pedir Lista por WhatsApp</span>
      </a>
      <p class="text-xs text-center text-stone-500 mt-3">
        Local en Pasteur 367, Once · Mínimo 1 bulto cerrado
      </p>
    </div>
  </div>
</header>

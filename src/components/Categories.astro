---
import { categories } from '../data/categories';
import { getWhatsAppLink } from '../data/site.config';
---

<section id="categorias" class="py-20 lg:py-24 bg-pastel-bg relative border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección con Badge Pastel -->
    <div class="text-center max-w-3xl mx-auto mb-14" data-drop-single>
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pastel-turquesa/30 border border-teal-200 text-brand-dark text-xs font-bold uppercase tracking-wider mb-3">
        <span>Catálogo Mayorista Curado</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-brand-dark tracking-tight mb-3">
        Líneas principales por bulto cerrado
      </h2>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed">
        Más de 1.400 artículos clasificados en 6 rubros de alta rotación para armar tu pedido mayorista sin perder tiempo.
      </p>
    </div>

    <!-- Grilla de 6 Tarjetas con Física Táctil y Colores Pastel -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" data-drop-group>
      {categories.map((cat) => {
        const catWhatsAppUrl = getWhatsAppLink(`¡Hola! Quiero consultar los modelos disponibles en la categoría: ${cat.name}.`);
        return (
          <div
            class="card-tactile relative bg-white rounded-2xl p-6 sm:p-7 border border-stone-200/90 shadow-soft-sm flex flex-col justify-between group overflow-hidden hover:shadow-soft transition-all"
            data-drop
          >
            <div>
              <!-- Header de la tarjeta: Badge Pastel e Ítem count -->
              <div class="flex items-center justify-between mb-4">
                <span class={`inline-block px-3 py-1 rounded-full text-xs font-heading font-bold border border-black/5 ${cat.badgeBg}`}>
                  {cat.badge}
                </span>
                <span class="text-xs font-bold text-stone-500 bg-stone-100 px-2.5 py-1 rounded-full">
                  {cat.itemCount}
                </span>
              </div>

              <!-- Nombre y Descripción -->
              <h3 class="text-2xl font-heading font-black text-brand-dark mb-2 group-hover:text-teal-700 transition-colors duration-150">
                {cat.name}
              </h3>
              <p class="text-sm text-brand-muted leading-relaxed mb-5">
                {cat.description}
              </p>

              <!-- Tags de personajes populares en esa categoría -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {cat.popularItems.map((item) => (
                  <span class="px-2.5 py-1 rounded-md bg-stone-50 text-[11px] font-bold text-brand-dark/80 border border-stone-200/80">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer con Botón a WhatsApp para esa categoría -->
            <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
              <span class="text-xs font-bold text-brand-muted">Venta por pack cerrado</span>
              <a
                href={catWhatsAppUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm font-heading font-bold text-brand-dark hover:text-teal-700 transition-colors"
              >
                <span>Pedir Modelos</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

---
import { siteConfig } from '../data/site.config';
---

<section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-soft-md border border-stone-200/90 grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8" data-drop-group>
    
    <!-- Métrica 1: +1400 Productos (Pastel Turquesa) -->
    <div class="flex items-center gap-4 border-b sm:border-b-0 sm:border-r border-stone-100 pb-4 sm:pb-0 pr-0 sm:pr-4" data-drop>
      <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-2xl bg-pastel-turquesa/25 border border-teal-200 flex items-center justify-center shrink-0 text-teal-800">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-brand-dark">
          +<span class="counter-value" data-target="1400">1400</span>
        </div>
        <p class="text-xs sm:text-sm font-semibold text-brand-muted">Productos en catálogo</p>
      </div>
    </div>

    <!-- Métrica 2: 100% Envíos (Pastel Rosa) -->
    <div class="flex items-center gap-4 border-b sm:border-b-0 lg:border-r border-stone-100 pb-4 sm:pb-0 pr-0 lg:pr-4" data-drop>
      <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-2xl bg-pastel-rosa/25 border border-pink-200 flex items-center justify-center shrink-0 text-pink-700">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
        </svg>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-brand-dark">
          <span class="counter-value" data-target="100">100</span>%
        </div>
        <p class="text-xs sm:text-sm font-semibold text-brand-muted">Envíos a todo el país</p>
      </div>
    </div>

    <!-- Métrica 3: Local en Once (Pastel Amarillo) -->
    <div class="flex items-center gap-4 border-b sm:border-b-0 sm:border-r border-stone-100 pb-4 sm:pb-0 pr-0 sm:pr-4" data-drop>
      <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-2xl bg-pastel-amarillo/40 border border-amber-300 flex items-center justify-center shrink-0 text-amber-800">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <div class="text-xl sm:text-2xl lg:text-3xl font-heading font-black text-brand-dark">
          Pasteur 367
        </div>
        <p class="text-xs sm:text-sm font-semibold text-brand-muted">Local a la calle en Once</p>
      </div>
    </div>

    <!-- Métrica 4: Atención por WhatsApp (Pastel Violeta) -->
    <div class="flex items-center gap-4" data-drop>
      <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-2xl bg-pastel-violeta/30 border border-purple-200 flex items-center justify-center shrink-0 text-purple-800">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl lg:text-4xl font-heading font-black text-brand-dark">
          <span class="counter-value" data-target="24">24</span> hs
        </div>
        <p class="text-xs sm:text-sm font-semibold text-brand-muted">Cotización por WhatsApp</p>
      </div>
    </div>

  </div>
</section>

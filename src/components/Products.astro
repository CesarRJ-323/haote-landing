---
import { products } from '../data/products';
import { getWhatsAppLink } from '../data/site.config';

const filterCategories = [
  { id: 'all', label: 'Todos los Rubros' },
  { id: 'Lego y Bloques', label: 'Lego y Bloques' },
  { id: 'Peluches', label: 'Peluches' },
  { id: 'Personajes y Pop', label: 'Figuras Pop' },
  { id: 'Verano', label: 'Línea Verano' },
  { id: 'Temporada / Fiestas', label: 'Temporada' },
];

const badgeColorMap: Record<string, string> = {
  amarillo: 'bg-pastel-amarillo text-brand-dark border-amber-300',
  rosa: 'bg-pastel-rosa text-brand-dark border-pink-300',
  turquesa: 'bg-pastel-turquesa text-brand-dark border-teal-300',
  violeta: 'bg-pastel-violeta text-brand-dark border-purple-300',
};
---

<section id="productos" class="py-20 lg:py-24 bg-white relative border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección con estilo limpio E-commerce -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6" data-drop-single>
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pastel-rosa/30 text-brand-dark text-xs font-bold uppercase tracking-wider mb-3 border border-pink-200">
          <span>Precios Reales Mayoristas</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-brand-dark tracking-tight">
          Productos Estrella en Once
        </h2>
        <p class="text-base sm:text-lg text-brand-muted mt-2 max-w-xl">
          Consultá disponibilidad en tiempo real. Todos los artículos se entregan en pack cerrado con packaging original.
        </p>
      </div>

      <!-- Botón Descargar Catálogo Completo -->
      <div>
        <a
          href={getWhatsAppLink('¡Hola! Quiero que me envíen el catálogo completo con los 1.400 productos y la lista de precios mayorista en Excel.')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-tactile inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-dark text-white font-heading font-bold text-sm sm:text-base hover:bg-stone-800 shadow-soft-sm"
        >
          <span>Descargar Lista Completa (+1.400)</span>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Barra de Filtros Interactiva por Rubro (Pastel Pills) -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar" id="category-filter-bar" data-drop-single>
      {filterCategories.map((filter, idx) => (
        <button
          type="button"
          data-filter={filter.id}
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-heading font-bold transition-all duration-150 shrink-0 border ${
            idx === 0
              ? 'bg-brand-dark text-white border-brand-dark active-filter shadow-soft-sm'
              : 'bg-pastel-bg text-brand-dark border-stone-200 hover:border-pastel-turquesa hover:bg-white'
          }`}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <!-- Grilla de Productos con Caída por Scroll -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="products-grid" data-drop-group>
      {products.map((product) => {
        const productWhatsAppUrl = getWhatsAppLink(product.whatsappMessage);
        const badgeClasses = badgeColorMap[product.badgeColor || 'turquesa'] || 'bg-pastel-turquesa text-brand-dark border-teal-300';
        return (
          <div
            class="product-item card-tactile bg-white rounded-2xl p-4 border border-stone-200 shadow-soft-sm hover:border-teal-300 hover:shadow-soft-md flex flex-col justify-between group transition-all"
            data-category={product.category}
            data-drop
          >
            <!-- Contenedor de Imagen de Producto con Zoom Interior suave -->
            <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-pastel-bg p-3 mb-4 flex items-center justify-center border border-stone-100">
              
              <!-- Badge de estado pastel -->
              {product.badge && (
                <div class="absolute top-2.5 left-2.5 z-10">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-heading font-bold border ${badgeClasses}`}>
                    {product.badge}
                  </span>
                </div>
              )}

              <!-- Imagen con micro-zoom en hover -->
              <img
                src={product.image}
                alt={product.cleanName}
                loading="lazy"
                class="w-full h-full object-contain transition-transform duration-200 ease-out group-hover:scale-[1.03]"
              />
            </div>

            <!-- Información del Producto -->
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-brand-muted block mb-1">
                {product.category}
              </span>
              <h3 class="text-base sm:text-lg font-heading font-bold text-brand-dark line-clamp-1 mb-1 group-hover:text-teal-700 transition-colors" title={product.name}>
                {product.cleanName}
              </h3>
              
              <!-- Badge del Pack Mayorista -->
              <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-teal-50 text-teal-800 text-xs font-bold border border-teal-200 mb-3">
                <svg class="w-3.5 h-3.5 text-teal-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                </svg>
                <span>{product.pack}</span>
              </div>
            </div>

            <!-- Precio y Botón CTA a WhatsApp -->
            <div class="pt-3 border-t border-stone-100 mt-2">
              <div class="flex items-baseline justify-between mb-3">
                <div>
                  <span class="text-2xl font-heading font-black text-brand-dark">
                    {product.formattedPrice}
                  </span>
                  <span class="text-[11px] block text-stone-500 font-semibold">Precio bulto cerrado</span>
                </div>
                <div class="text-right">
                  <span class="text-xs font-extrabold text-teal-800 bg-pastel-turquesa/20 px-2 py-0.5 rounded-md border border-teal-200 block">
                    {product.unitPrice}
                  </span>
                </div>
              </div>

              <a
                href={productWhatsAppUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tactile w-full inline-flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-xs sm:text-sm border border-teal-300 hover:bg-[#38C6D8] shadow-soft-sm"
              >
                <!-- WhatsApp Mini Icon -->
                <svg class="w-4 h-4 text-brand-dark fill-current shrink-0" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.862 2.802.862l.006-.001c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.78-5.768zm3.364 8.169c-.14.394-.805.748-1.127.794-.322.046-.737.065-1.18-.08-.442-.144-1.014-.338-1.758-1.077-.927-.923-1.536-2.072-1.745-2.423-.209-.352-.022-.542.155-.717.158-.157.352-.404.528-.606.176-.202.234-.344.351-.572.117-.229.059-.429-.029-.606-.088-.176-.791-1.907-1.085-2.613-.286-.689-.577-.596-.791-.607-.205-.01-.44-.012-.674-.012-.235 0-.616.088-.939.44-.322.352-1.231 1.203-1.231 2.934 0 1.732 1.26 3.407 1.436 3.642.176.235 2.479 3.786 6.006 5.308.839.362 1.494.578 2.004.74.843.268 1.61.23 2.216.14.675-.101 2.08-.85 2.373-1.67.293-.82.293-1.523.205-1.67-.088-.147-.322-.235-.674-.411z"/>
                </svg>
                <span>Pedir Bulto</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<!-- Script para filtrado reactivo -->
<script>
  function setupProductFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const productItems = document.querySelectorAll<HTMLElement>('.product-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        // Actualizar estados visuales de los botones
        filterButtons.forEach((b) => {
          b.classList.remove('bg-brand-dark', 'text-white', 'border-brand-dark', 'active-filter', 'shadow-soft-sm');
          b.classList.add('bg-pastel-bg', 'text-brand-dark', 'border-stone-200');
        });

        btn.classList.add('bg-brand-dark', 'text-white', 'border-brand-dark', 'active-filter', 'shadow-soft-sm');
        btn.classList.remove('bg-pastel-bg', 'text-brand-dark', 'border-stone-200');

        // Filtrar productos
        productItems.forEach((item) => {
          const category = item.dataset.category || '';
          if (filter === 'all' || category === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  }

  // Inicializar al cargar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProductFilters);
  } else {
    setupProductFilters();
  }
</script>

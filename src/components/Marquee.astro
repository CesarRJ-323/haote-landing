---
import { siteConfig } from '../data/site.config';

// Duplicamos la lista para generar el loop visual continuo sin saltos
const marqueeList = [...siteConfig.marqueeItems, ...siteConfig.marqueeItems];
const dotColors = ['bg-pastel-turquesa', 'bg-pastel-rosa', 'bg-pastel-amarillo', 'bg-pastel-violeta'];
---

<section class="py-8 bg-white overflow-hidden border-y border-stone-200/80" aria-hidden="true">
  <div class="relative w-full">
    <!-- Degradados laterales para suavizar la entrada/salida -->
    <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <div class="animate-marquee flex items-center gap-3">
      {marqueeList.map((item, index) => {
        const dotColor = dotColors[index % dotColors.length];
        return (
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-pastel-bg shadow-soft-sm border border-stone-200 shrink-0">
            <span class={`w-2.5 h-2.5 rounded-full ${dotColor} border border-black/10`}></span>
            <span class="font-heading font-bold text-xs sm:text-sm text-brand-dark tracking-wide">
              {item}
            </span>
            <span class="text-stone-400 font-bold text-xs">★</span>
          </div>
        );
      })}
    </div>
  </div>
</section>

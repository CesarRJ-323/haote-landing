---
import { getWhatsAppLink } from '../data/site.config';
---

<section id="simulador" class="py-18 lg:py-24 bg-pastel-bg relative border-b border-stone-200/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-stone-200 shadow-soft-md" data-drop-single>
      
      <!-- Encabezado de la Herramienta -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pastel-turquesa/30 border border-teal-200 text-brand-dark text-xs font-bold uppercase tracking-wider mb-3">
          <span>Herramienta para Comerciantes</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-heading font-black text-brand-dark tracking-tight mb-2">
          Calculadora de Margen y Ganancia
        </h2>
        <p class="text-sm sm:text-base text-brand-muted">
          Simulá en segundos tu rentabilidad real al revender los productos en tu kiosco, juguetería o local.
        </p>
      </div>

      <!-- Grid del Simulador -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        
        <!-- Columna Izquierda: Parámetros del cálculo -->
        <div class="md:col-span-7 space-y-6">
          
          <!-- Selector de Producto -->
          <div>
            <label for="calc-product" class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-2">
              1. Seleccioná el producto mayorista
            </label>
            <select
              id="calc-product"
              class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-pastel-bg font-heading font-bold text-brand-dark focus:outline-none focus:ring-2 focus:ring-pastel-turquesa"
            >
              <option value="21500,8,4500">LEGO Spiderman (Pack x8 — Costo: $21.500)</option>
              <option value="25000,4,9500">LEGO Stitch (Pack x4 — Costo: $25.000)</option>
              <option value="21500,8,4500">LEGO Pokémon (Pack x8 — Costo: $21.500)</option>
              <option value="6500,1,12000">POP Stitch Coleccionable (Costo: $6.500 c/u)</option>
              <option value="26000,4,11000">Peluche Spiderman 35cm (Pack x4 — Costo: $26.000)</option>
              <option value="24000,4,10500">Pistola de Agua Mochila (Pack x4 — Costo: $24.000)</option>
              <option value="28000,2,24000">Calendario de Adviento (Pack x2 — Costo: $28.000)</option>
            </select>
          </div>

          <!-- Slider / Input de Precio de Venta al Público -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="calc-resell-price" class="text-xs font-bold uppercase tracking-wider text-brand-dark">
                2. Tu precio de venta estimado x unidad
              </label>
              <span id="display-unit-price" class="font-heading font-black text-brand-dark text-lg">$4.500</span>
            </div>
            <input
              type="range"
              id="calc-resell-price"
              min="3000"
              max="20000"
              step="250"
              value="4500"
              class="w-full accent-teal-600 cursor-pointer"
            />
            <div class="flex justify-between text-[11px] font-bold text-brand-muted mt-1">
              <span>Mínimo sugerido</span>
              <span>Precio premium</span>
            </div>
          </div>

          <!-- Datos de costo base -->
          <div class="p-3.5 rounded-xl bg-pastel-bg border border-stone-200 text-xs flex justify-between items-center">
            <span class="text-stone-600">Costo unitario mayorista: <strong id="calc-cost-unit" class="text-brand-dark">$2.687</strong></span>
            <span class="text-stone-600">Unidades en el pack: <strong id="calc-units-count" class="text-brand-dark">8</strong></span>
          </div>

        </div>

        <!-- Columna Derecha: Tarjeta de Rentabilidad Proyectada -->
        <div class="md:col-span-5 bg-brand-dark text-white p-6 sm:p-7 rounded-2xl border-2 border-pastel-turquesa shadow-soft-sm flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-pastel-amarillo block mb-1">
              Resultado por Pack Cerrado
            </span>
            <h4 class="text-xs text-white/70 font-semibold mb-6">
              Recuperás tu inversión inicial y obtenés:
            </h4>

            <div class="space-y-4">
              <div>
                <span class="text-xs text-white/70 block">Ganancia neta por bulto:</span>
                <span id="calc-net-profit" class="text-3xl sm:text-4xl font-heading font-black text-pastel-amarillo">
                  +$14.500
                </span>
              </div>

              <div class="pt-3 border-t border-white/10 flex items-center justify-between">
                <div>
                  <span class="text-[11px] text-white/60 block">Margen de ganancia:</span>
                  <span id="calc-margin-percent" class="text-xl font-heading font-extrabold text-pastel-turquesa">
                    +67%
                  </span>
                </div>
                <div class="text-right">
                  <span class="text-[11px] text-white/60 block">Recaudación total:</span>
                  <span id="calc-gross-revenue" class="text-base font-bold text-white">
                    $36.000
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              id="calc-whatsapp-btn"
              href={getWhatsAppLink('¡Hola! Usé el simulador de ganancias para LEGO Spiderman y quiero pedir este pack.')}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-tactile w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-sm hover:bg-[#38C6D8] border border-teal-300"
            >
              <span>Pedir este producto por WhatsApp</span>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Lógica interactiva en cliente -->
<script>
  function initMarginCalculator() {
    const productSelect = document.getElementById('calc-product') as HTMLSelectElement | null;
    const resellSlider = document.getElementById('calc-resell-price') as HTMLInputElement | null;
    const displayUnitPrice = document.getElementById('display-unit-price');
    const calcCostUnit = document.getElementById('calc-cost-unit');
    const calcUnitsCount = document.getElementById('calc-units-count');
    const calcNetProfit = document.getElementById('calc-net-profit');
    const calcMarginPercent = document.getElementById('calc-margin-percent');
    const calcGrossRevenue = document.getElementById('calc-gross-revenue');
    const whatsappBtn = document.getElementById('calc-whatsapp-btn') as HTMLAnchorElement | null;

    if (!productSelect || !resellSlider) return;

    function formatCurrency(num: number): string {
      return '$' + num.toLocaleString('es-AR');
    }

    function calculate() {
      if (!productSelect || !resellSlider) return;
      const [costStr, unitsStr, defaultSellStr] = productSelect.value.split(',');
      const cost = parseInt(costStr, 10);
      const units = parseInt(unitsStr, 10);
      const sellPrice = parseInt(resellSlider.value, 10);

      const unitCost = Math.round(cost / units);
      const grossRevenue = sellPrice * units;
      const netProfit = grossRevenue - cost;
      const marginPct = cost > 0 ? Math.round((netProfit / cost) * 100) : 0;

      if (displayUnitPrice) displayUnitPrice.innerText = formatCurrency(sellPrice);
      if (calcCostUnit) calcCostUnit.innerText = formatCurrency(unitCost);
      if (calcUnitsCount) calcUnitsCount.innerText = units.toString();
      if (calcGrossRevenue) calcGrossRevenue.innerText = formatCurrency(grossRevenue);
      if (calcNetProfit) {
        calcNetProfit.innerText = (netProfit >= 0 ? '+' : '') + formatCurrency(netProfit);
      }
      if (calcMarginPercent) {
        calcMarginPercent.innerText = (marginPct >= 0 ? '+' : '') + marginPct + '%';
      }

      if (whatsappBtn) {
        const productName = productSelect.options[productSelect.selectedIndex].text.split('(')[0].trim();
        const msg = encodeURIComponent(
          `¡Hola! Usé el simulador de rentabilidad en la web para ${productName}. Calculé vender a ${formatCurrency(sellPrice)} y quiero pedir stock por bulto cerrado.`
        );
        whatsappBtn.href = `https://wa.me/5491136709874?text=${msg}`;
      }
    }

    productSelect.addEventListener('change', () => {
      const parts = productSelect.value.split(',');
      const defaultSell = parseInt(parts[2], 10);
      const cost = parseInt(parts[0], 10);
      const units = parseInt(parts[1], 10);
      const unitCost = Math.round(cost / units);

      resellSlider.min = Math.round(unitCost * 1.2).toString();
      resellSlider.max = Math.round(unitCost * 3.5).toString();
      resellSlider.value = defaultSell.toString();
      calculate();
    });

    resellSlider.addEventListener('input', calculate);
    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMarginCalculator);
  } else {
    initMarginCalculator();
  }
</script>

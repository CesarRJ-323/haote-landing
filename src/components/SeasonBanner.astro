---
import { siteConfig, getWhatsAppLink } from '../data/site.config';

const { seasonBanner } = siteConfig;
const seasonWhatsAppUrl = getWhatsAppLink(seasonBanner.whatsappMessage);
---

<section id="temporada" class="py-16 lg:py-24 bg-pastel-bg relative border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="relative rounded-3xl lg:rounded-4xl bg-gradient-to-r from-pastel-violeta/25 via-pastel-rosa/20 to-pastel-amarillo/30 p-8 sm:p-12 lg:p-16 overflow-hidden shadow-soft-md border border-purple-200"
      data-drop-single
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <!-- Texto Promocional de Temporada -->
        <div class="lg:col-span-8 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pastel-rosa text-brand-dark text-xs sm:text-sm font-bold uppercase tracking-wider mb-5 border border-pink-300 shadow-soft-sm">
            <span>★ {seasonBanner.badge}</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-brand-dark tracking-tight mb-4 leading-tight">
            {seasonBanner.title}
          </h2>

          <p class="text-base sm:text-lg text-brand-muted max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-8">
            {seasonBanner.description}
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href={seasonWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-tactile w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-base sm:text-lg border border-teal-300 shadow-soft hover:bg-[#38C6D8]"
            >
              <!-- WhatsApp Icon -->
              <svg class="w-5 h-5 text-brand-dark fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.862 2.802.862l.006-.001c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.78-5.768zm3.364 8.169c-.14.394-.805.748-1.127.794-.322.046-.737.065-1.18-.08-.442-.144-1.014-.338-1.758-1.077-.927-.923-1.536-2.072-1.745-2.423-.209-.352-.022-.542.155-.717.158-.157.352-.404.528-.606.176-.202.234-.344.351-.572.117-.229.059-.429-.029-.606-.088-.176-.791-1.907-1.085-2.613-.286-.689-.577-.596-.791-.607-.205-.01-.44-.012-.674-.012-.235 0-.616.088-.939.44-.322.352-1.231 1.203-1.231 2.934 0 1.732 1.26 3.407 1.436 3.642.176.235 2.479 3.786 6.006 5.308.839.362 1.494.578 2.004.74.843.268 1.61.23 2.216.14.675-.101 2.08-.85 2.373-1.67.293-.82.293-1.523.205-1.67-.088-.147-.322-.235-.674-.411z"/>
              </svg>
              <span>{seasonBanner.ctaText}</span>
            </a>
          </div>
        </div>

        <!-- Columna Gráfica: Producto de temporada -->
        <div class="lg:col-span-4 flex items-center justify-center">
          <div class="relative w-64 sm:w-72 aspect-square rounded-3xl bg-white p-6 border border-stone-200 shadow-soft-sm flex items-center justify-center group hover:scale-102 transition-transform">
            <img
              src="/images/products/calendario-adviento.svg"
              alt="Calendario de Adviento Mayorista"
              class="w-full h-full object-contain filter drop-shadow-sm"
            />
            <div class="absolute -bottom-3 bg-pastel-amarillo text-brand-dark px-4 py-1 rounded-full font-heading font-black text-xs shadow-soft-sm border border-amber-300">
              ¡PACK X2 EN STOCK!
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

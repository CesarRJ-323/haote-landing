---
import { siteConfig, getWhatsAppLink } from '../data/site.config';

const finalWhatsAppUrl = getWhatsAppLink('¡Hola! Quiero hacer mi primer pedido mayorista en Importadora Haote. ¿Me envían el catálogo y lista de precios?');
---

<section class="py-20 lg:py-28 bg-gradient-to-b from-pastel-bg via-white to-pastel-bg relative overflow-hidden border-b border-stone-200/80">
  <!-- Círculos de luz pastel suave -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[40rem] h-96 bg-pastel-turquesa/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-10 w-80 h-80 bg-pastel-rosa/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10" data-drop-single>
    
    <!-- Badge Pastel -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pastel-turquesa/30 border border-teal-200 text-teal-900 text-xs sm:text-sm font-bold uppercase tracking-wider mb-6 shadow-soft-sm">
      <span>Atención Inmediata por WhatsApp</span>
    </div>

    <!-- Título Principal -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-brand-dark tracking-tight leading-tight mb-6">
      Aumentá las ventas de tu negocio<br class="hidden sm:inline" /> con los juguetes del momento
    </h2>

    <!-- Subtítulo -->
    <p class="text-base sm:text-lg text-brand-muted max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
      Escribinos ahora. Te enviamos la lista mayorista completa con precios vigentes y te asesoramos sobre los artículos con mayor rotación para tu zona.
    </p>

    <!-- Botón CTA WhatsApp Principal -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={finalWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-tactile w-full sm:w-auto inline-flex items-center justify-center gap-3 px-9 py-4 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-lg border border-teal-300 shadow-soft hover:bg-[#38C6D8]"
      >
        <!-- WhatsApp Icon -->
        <svg class="w-6 h-6 text-brand-dark fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.862 2.802.862l.006-.001c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.78-5.768zm3.364 8.169c-.14.394-.805.748-1.127.794-.322.046-.737.065-1.18-.08-.442-.144-1.014-.338-1.758-1.077-.927-.923-1.536-2.072-1.745-2.423-.209-.352-.022-.542.155-.717.158-.157.352-.404.528-.606.176-.202.234-.344.351-.572.117-.229.059-.429-.029-.606-.088-.176-.791-1.907-1.085-2.613-.286-.689-.577-.596-.791-.607-.205-.01-.44-.012-.674-.012-.235 0-.616.088-.939.44-.322.352-1.231 1.203-1.231 2.934 0 1.732 1.26 3.407 1.436 3.642.176.235 2.479 3.786 6.006 5.308.839.362 1.494.578 2.004.74.843.268 1.61.23 2.216.14.675-.101 2.08-.85 2.373-1.67.293-.82.293-1.523.205-1.67-.088-.147-.322-.235-.674-.411z"/>
        </svg>
        <span>Hablar con un Asesor Mayorista</span>
      </a>
    </div>

    <!-- Micro sellos de garantía -->
    <div class="mt-12 pt-8 border-t border-stone-200/80 flex flex-wrap items-center justify-center gap-8 text-xs sm:text-sm text-brand-muted">
      <span class="flex items-center gap-1.5">
        <strong class="text-teal-600 font-bold">✓</strong> Precios directos sin intermediarios
      </span>
      <span class="flex items-center gap-1.5">
        <strong class="text-teal-600 font-bold">✓</strong> Packs cerrados con packaging original
      </span>
      <span class="flex items-center gap-1.5">
        <strong class="text-teal-600 font-bold">✓</strong> Despacho asegurado a transportes
      </span>
    </div>

  </div>
</section>

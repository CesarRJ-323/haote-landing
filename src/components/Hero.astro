---
import { siteConfig, getWhatsAppLink } from '../data/site.config';

const whatsAppUrl = getWhatsAppLink('¡Hola! Vengo desde la web y quiero pedir la lista de precios mayoristas actualizada con fotos.');
---

<section class="relative min-h-[580px] lg:min-h-[640px] bg-gradient-to-b from-white via-pastel-bg to-white overflow-hidden flex items-center pt-32 pb-16 lg:pt-36 lg:pb-20 hero-container w-full border-b border-stone-200/80">
  
  <!-- Formas suaves orgánicas de fondo (Pastel Blur, no neón) -->
  <div class="absolute top-10 left-1/4 w-96 h-96 bg-pastel-turquesa/15 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-5 right-1/4 w-96 h-96 bg-pastel-rosa/15 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Columna Izquierda: Copywriting Mayorista Límpido y Humano -->
      <div class="lg:col-span-7 text-center lg:text-left">
        
        <!-- Sello de Autenticidad Comercial de Once (Pastel Amarillo Manteca) -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pastel-amarillo/50 border border-amber-300/80 text-brand-dark text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-5 max-w-full shadow-soft-sm">
          <span class="w-2 h-2 rounded-full bg-teal-500 shrink-0"></span>
          <span class="sm:hidden">Pasteur 367 · Once · Mayorista</span>
          <span class="hidden sm:inline">Importadora Directa · Pasteur 367, Once, CABA</span>
        </div>

        <!-- Título Principal Limpio con Tipografía Humana -->
        <h1 class="hero-title text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-black text-brand-dark leading-tight tracking-tight mb-5">
          Los juguetes de moda,<br />
          al verdadero<br class="sm:hidden" /> <span class="relative inline-block px-2 bg-pastel-turquesa/40 rounded-lg">precio mayorista</span>
        </h1>

        <!-- Subtítulo con datos comerciales concretos -->
        <p class="hero-subtitle text-base sm:text-lg text-brand-muted max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed mb-8">
          Abastecé tu juguetería, kiosco, regalería o showroom con stock inmediato de <strong class="text-brand-dark font-bold">más de 1.400 artículos</strong> por bulto y pack cerrado. Lego surtido, Stitch, Spiderman, Pop coleccionables y línea verano listos para despacho.
        </p>

        <!-- CTAs con física táctil y colores pasteles sólidos -->
        <div class="hero-cta flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4">
          <a
            href={whatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-tactile w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-pastel-turquesa text-brand-dark font-heading font-bold text-base sm:text-lg border border-teal-300 shadow-soft hover:bg-[#38C6D8]"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-5 h-5 text-brand-dark fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.771.862 2.802.862l.006-.001c3.182 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.78-5.768zm3.364 8.169c-.14.394-.805.748-1.127.794-.322.046-.737.065-1.18-.08-.442-.144-1.014-.338-1.758-1.077-.927-.923-1.536-2.072-1.745-2.423-.209-.352-.022-.542.155-.717.158-.157.352-.404.528-.606.176-.202.234-.344.351-.572.117-.229.059-.429-.029-.606-.088-.176-.791-1.907-1.085-2.613-.286-.689-.577-.596-.791-.607-.205-.01-.44-.012-.674-.012-.235 0-.616.088-.939.44-.322.352-1.231 1.203-1.231 2.934 0 1.732 1.26 3.407 1.436 3.642.176.235 2.479 3.786 6.006 5.308.839.362 1.494.578 2.004.74.843.268 1.61.23 2.216.14.675-.101 2.08-.85 2.373-1.67.293-.82.293-1.523.205-1.67-.088-.147-.322-.235-.674-.411z"/>
            </svg>
            <span>Pedir Lista de Precios en Excel / PDF</span>
          </a>

          <a
            href="#productos"
            class="btn-tactile w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white hover:bg-stone-50 text-brand-dark font-heading font-semibold text-base border border-stone-200 shadow-soft-sm"
          >
            <span>Explorar Catálogo</span>
            <svg class="w-4 h-4 text-stone-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Fila de Garantías Comerciales Claras -->
        <div class="mt-8 pt-6 border-t border-stone-200/80 flex flex-wrap items-center justify-center lg:justify-start gap-5 text-xs text-brand-muted">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-pastel-turquesa/40 text-teal-800 flex items-center justify-center text-[10px] font-black">✓</span>
            <span>Mínimo: 1 bulto cerrado</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-pastel-turquesa/40 text-teal-800 flex items-center justify-center text-[10px] font-black">✓</span>
            <span>Despacho al expreso en 24 hs</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-pastel-turquesa/40 text-teal-800 flex items-center justify-center text-[10px] font-black">✓</span>
            <span>Factura A y B</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-pastel-turquesa/40 text-teal-800 flex items-center justify-center text-[10px] font-black">✓</span>
            <span>Retiro inmediato en local</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta de Producto Central Estilo E-Commerce Real -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-2 lg:mt-0">
        
        <!-- Marco de Producto Principal -->
        <div class="hero-product-card relative w-72 sm:w-88 md:w-96 rounded-3xl bg-white p-5 shadow-soft-md border border-stone-200/90 flex flex-col items-center">
          
          <!-- Encabezado de la tarjeta -->
          <div class="w-full flex items-center justify-between pb-3 border-b border-stone-100">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-pastel-rosa text-brand-dark border border-pink-200">
              ★ TOP VENTAS ONCE
            </span>
            <span class="text-xs font-bold text-teal-800 bg-pastel-turquesa/25 px-2.5 py-1 rounded-full border border-teal-200">
              Stock Inmediato
            </span>
          </div>

          <!-- Imagen destacada -->
          <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden bg-pastel-bg p-4 my-3 flex items-center justify-center border border-stone-100">
            <img
              src="/images/products/lego-spiderman-x8.svg"
              alt="LEGO Spiderman Surtido Pack x8"
              class="w-full h-full object-contain filter drop-shadow-sm"
            />
          </div>

          <!-- Datos de precio y pack -->
          <div class="w-full pt-2 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-stone-500 block">Pack x8 unidades</span>
              <span class="text-2xl font-heading font-black text-brand-dark">$21.500</span>
            </div>
            <div class="text-right">
              <span class="text-[11px] font-bold text-stone-500 block">Costo unitario</span>
              <span class="text-xs font-extrabold text-brand-dark bg-pastel-amarillo px-2.5 py-1 rounded-lg border border-amber-300">
                $2.687 / u.
              </span>
            </div>
          </div>

          <!-- Micro-insignia flotante: Margen de reventa -->
          <div class="absolute -bottom-4 bg-pastel-violeta text-brand-dark px-4 py-1.5 rounded-full shadow-soft-sm font-heading font-bold text-xs border border-purple-200">
            Margen sugerido: +70% a +100%
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

---
import { siteConfig } from '../data/site.config';
---

<footer class="bg-slate-900 text-white pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Columna 1: Marca y Propósito -->
      <div class="lg:col-span-5 space-y-4">
        <a href="#" class="inline-block">
          <img
            src="/images/brand/logo.svg"
            alt="Importadora Haote"
            class="h-12 w-auto object-contain brightness-110"
          />
        </a>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {siteConfig.description}
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p><strong>Dirección:</strong> {siteConfig.location.address}, {siteConfig.location.neighborhood}, {siteConfig.location.city}</p>
          <p><strong>Horarios:</strong> {siteConfig.location.schedule}</p>
        </div>
      </div>

      <!-- Columna 2: Navegación Rápida -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-heading font-bold text-base text-pastel-turquesa uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2 text-sm text-slate-300">
          <li><a href="#categorias" class="hover:text-pastel-turquesa transition-colors">Categorías Principales</a></li>
          <li><a href="#productos" class="hover:text-pastel-turquesa transition-colors">Productos Estrella</a></li>
          <li><a href="#simulador" class="hover:text-pastel-turquesa transition-colors">Simulador de Margen</a></li>
          <li><a href="#como-comprar" class="hover:text-pastel-turquesa transition-colors">¿Cómo Comprar?</a></li>
          <li><a href="#temporada" class="hover:text-pastel-turquesa transition-colors">Temporada 2026</a></li>
          <li><a href="#ubicacion" class="hover:text-pastel-turquesa transition-colors">Ubicación y Local en Once</a></li>
        </ul>
      </div>

      <!-- Columna 3: Rubros Mayoristas -->
      <div class="lg:col-span-4 space-y-3">
        <h4 class="font-heading font-bold text-base text-pastel-amarillo uppercase tracking-wider">
          Rubros Destacados
        </h4>
        <div class="flex flex-wrap gap-2">
          {siteConfig.marqueeItems.slice(0, 10).map((cat) => (
            <span class="px-2.5 py-1 rounded-md bg-slate-800 text-xs text-slate-300 border border-slate-700">
              {cat}
            </span>
          ))}
        </div>
      </div>

    </div>

    <!-- Barra de Créditos, Aviso de Demo y Derechos -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400 text-center md:text-left">
      <div>
        <p>© {new Date().getFullYear()} {siteConfig.name} · Pasteur 367, Once, CABA, Argentina.</p>
        <p class="text-[11px] text-slate-500 mt-1">
          Inspirado en tiendas boutique de Tiendanube (Roma Store) con paleta pastel suave.
        </p>
      </div>

      <div class="p-2.5 rounded-lg bg-slate-800 border border-slate-700 text-[11px] text-pastel-amarillo max-w-md">
        ⚠️ <strong>Aviso de Demostración:</strong> Fotos y marcas propiedad de Importadora Haote, utilizadas exclusivamente para la presentación de la propuesta de rediseño.
      </div>
    </div>
  </div>
</footer>

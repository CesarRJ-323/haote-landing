---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Marquee from '../components/Marquee.astro';
import Categories from '../components/Categories.astro';
import Products from '../components/Products.astro';
import MarginCalculator from '../components/MarginCalculator.astro';
import HowToBuy from '../components/HowToBuy.astro';
import SeasonBanner from '../components/SeasonBanner.astro';
import Location from '../components/Location.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout>
  <!-- 1. Navbar con barra de aviso mayorista -->
  <Navbar />

  <!-- 2. Hero con estética auténtica de juguetería mayorista -->
  <Hero />

  <!-- 3. Barra de confianza con contadores numéricos animados -->
  <TrustBar />

  <!-- 4. Marquee continuo con rubros y personajes de moda -->
  <Marquee />

  <!-- 5. Categorías destacadas (6 tarjetas táctiles) -->
  <Categories />

  <!-- 6. Productos estrella (grilla con filtro instantáneo y precios reales) -->
  <Products />

  <!-- 7. Simulador Interactivo de Margen y Rentabilidad -->
  <MarginCalculator />

  <!-- 8. Cómo comprar por mayor (3 pasos sencillos y claros) -->
  <HowToBuy />

  <!-- 9. Banner de Temporada (Navidad / Calendarios de Adviento y Verano) -->
  <SeasonBanner />

  <!-- 10. Ubicación ilustrada (Pasteur 367, Once, CABA) con plano vectorial -->
  <Location />

  <!-- 11. CTA Final de alto impacto con botón directo a WhatsApp -->
  <FinalCTA />

  <!-- 12. Footer completo con datos y aviso de demo -->
  <Footer />

  <!-- 13. Botón flotante de WhatsApp siempre visible con pulso -->
  <WhatsAppFloat />
</Layout>
